{
  "name": "politicsplace",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "wrangler dev",
    "deploy": "pnpm build && pnpm db:backup && wrangler deploy",
    "typecheck": "react-router typegen && tsc",
    "cf:types": "wrangler types",
    "db:local": "wrangler d1 execute politicsplace --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute politicsplace --remote --file=./schema.sql",
    "db:backup": "node scripts/backup-db.mjs",
    "polls:pull": "node scripts/pull-polls.mjs",
    "polls:538": "node scripts/import-538-polls.mjs",
    "polls:wikipedia": "node scripts/import-wikipedia-polls.mjs",
    "ratings:pull": "node scripts/import-race-ratings.mjs",
    "polls:all": "node scripts/polls-all.mjs",
    "fundraising:pull": "node scripts/pull-fundraising.mjs",
    "fundraising:donors": "node scripts/pull-donor-locations.mjs",
    "fundraising:donor-details": "node scripts/pull-donor-details.mjs",
    "fundraising:spending": "node scripts/pull-spending.mjs",
    "earlyvoting:pull": "node scripts/pull-early-voting.mjs",
    "geo:extract": "node scripts/extract-county-geo.mjs",
    "geo:precincts": "node scripts/extract-precincts.mjs",
    "geo:precinct-results": "node scripts/join-precinct-results.mjs",
    "geo:districts": "node scripts/assign-precincts-to-districts.mjs",
    "oh7:precincts": "node scripts/build-oh7-precincts.mjs"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "playwright-core": "^1.63.0",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.2.2",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "vite": "^8.0.3",
    "wrangler": "^4.135.0"
  }
}