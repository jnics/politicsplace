.DS_Store
.env
/node_modules/

# React Router
/.react-router/
/build/

# Cloudflare — wrangler's local dev state (includes the local D1 SQLite file)
# and secrets. worker-configuration.d.ts (generated by `wrangler types`) is
# committed on purpose, same as .react-router/types would be if that weren't
# already ignored -- regenerate it after any wrangler.jsonc binding change.
/.wrangler/
.dev.vars
.dev.vars.*

# playwright profile for scripts/pull-polls.mjs
/.rcp-profile/

# cached FiveThirtyEight raw-polls CSV (scripts/import-538-polls.mjs fallback)
/scripts/data/raw-polls-538.csv

# Big Board (/election2026), voter chase (/chase), OH-7 tally (/results), and
# manually-submitted polls (/polls/submit) all live in D1 now (see schema.sql)
# instead of local *-data.json files -- nothing left to ignore for them.

# D1 snapshots from `pnpm db:backup` (scripts/backup-db.mjs) -- these can
# contain everyone's poll submissions/results, keep them local only.
/backups/
